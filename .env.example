# Copy to .env and fill in. `.env` is git-ignored; never commit tokens.

# Fine-grained, READ-ONLY token (Public repositories: read). Used for ingestion only.
GITHUB_TOKEN=
# The only repo OpsPilot may ever write to (comments/labels), e.g. yourname/opspilot-sandbox.
# Writes need a separate token with Issues: write on THIS repo only.
SANDBOX_REPO=
SANDBOX_GITHUB_TOKEN=

# small (~2k issues, demo) | full (20k+ issues)
MODE=small
# ollama | fake (deterministic, used in CI)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
JUDGE_MODEL=llama3.1:8b
OLLAMA_URL=http://host.docker.internal:11434
